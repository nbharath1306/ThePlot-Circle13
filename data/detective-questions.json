                {
                    "id": "cancel_plans",
                    "text": "How often do they cancel plans?",
                    "type": "multiple_choice",
                    "options": [
                        {
                            "label": "Never",
                            "value": "never"
                        },
                        {
                            "label": "Rarely",
                            "value": "rare"
                        },
                        {
                            "label": "Sometimes",
                            "value": "sometimes"
                        },
                        {
                            "label": "Often",
                            "value": "often"
