{
  "domains": [
    {
      "id": "intro",
      "title": "The Basics",
      "description": "Let's start with who you are.",
      "questions": [
        {
          "id": "name",
          "text": "What is your first name?",
          "type": "text",
          "placeholder": "Enter your name"
        },
        {
          "id": "age",
          "text": "How old are you?",
          "type": "number",
          "placeholder": "Age"
        }
      ]
    },
    {
      "id": "core_values",
      "title": "Core Values",
      "description": "What drives your decisions?",
      "questions": [
        {
          "id": "cv_1",
          "text": "How important is career ambition vs. work-life balance?",
          "type": "scale",
          "min": 1,
          "max": 10,
          "labels": {
            "1": "Pure Balance",
            "10": "Pure Ambition"
          }
        },
        {
          "id": "cv_2",
          "text": "When making big decisions, do you follow your head or your heart?",
          "type": "scale",
          "min": 1,
          "max": 10,
          "labels": {
            "1": "100% Logic",
            "10": "100% Emotion"
          }
        },
        {
          "id": "cv_3",
          "text": "How much do you value tradition vs. novelty/change?",
          "type": "scale",
          "min": 1,
          "max": 10,
          "labels": {
            "1": "Tradition",
            "10": "Novelty"
          }
        }
      ]
    },
    {
      "id": "conflict",
      "title": "Conflict Style",
      "description": "How do you fight?",
      "questions": [
        {
          "id": "conflict_1",
          "text": "In a heated argument, what is your instinct?",
          "type": "multiple_choice",
          "options": [
            {
              "label": "Fight to win / Prove I'm right",
              "value": "aggressive"
            },
            {
              "label": "Shut down / Withdraw",
              "value": "avoidant"
            },
            {
              "label": "Apologize to keep peace",
              "value": "anxious_pleasing"
            },
            {
              "label": "Pause and discuss calmly",
              "value": "secure"
            }
          ]
        },
        {
          "id": "conflict_2",
          "text": "How long do you hold a grudge?",
          "type": "scale",
          "min": 1,
          "max": 10,
          "labels": {
            "1": "Forgive instantly",
            "10": "Never forget"
          }
        }
      ]
    },
    {
      "id": "lifestyle",
      "title": "Lifestyle & Money",
      "description": "The day-to-day reality.",
      "questions": [
        {
          "id": "money_1",
          "text": "You get a $5,000 bonus. What do you do?",
          "type": "multiple_choice",
          "options": [
            {
              "label": "Save/Invest it all",
              "value": "saver"
            },
            {
              "label": "Book a luxury vacation",
              "value": "spender_experience"
            },
            {
              "label": "Buy that expensive item I've wanted",
              "value": "spender_material"
            },
            {
              "label": "Pay off debt",
              "value": "responsible"
            }
          ]
        },
        {
          "id": "social_1",
          "text": "It's Friday night. What is your ideal plan?",
          "type": "text",
          "placeholder": "e.g. Clubbing till 4am, or Pizza and Netflix?"
        }
      ]
    },
    {
      "id": "romance",
      "title": "Romance & Intimacy",
      "description": "The spice of life.",
      "questions": [
        {
          "id": "love_lang",
          "text": "What makes you feel most loved?",
          "type": "multiple_choice",
          "options": [
            {
              "label": "Words of Affirmation",
              "value": "words"
            },
            {
              "label": "Acts of Service",
              "value": "service"
            },
            {
              "label": "Receiving Gifts",
              "value": "gifts"
            },
            {
              "label": "Quality Time",
              "value": "time"
            },
            {
              "label": "Physical Touch",
              "value": "touch"
            }
          ]
        },
        {
          "id": "romance_1",
          "text": "How often do you need deep meaningful conversations?",
          "type": "scale",
          "min": 1,
          "max": 10,
          "labels": {
            "1": "Rarely",
            "10": "Daily"
          }
        }
      ]
    }
  ]
}